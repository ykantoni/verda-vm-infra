#!/bin/bash
# Bootstraps the RKE2 worker node and joins it to the control-plane. Run once over SSH by Terraform.
set -euo pipefail

exec > /var/log/rke2-install.log 2>&1

# Verda's GPU instance types (unlike its CPU types, where these are
# hardware-fixed off) ship with UDP tunnel/VXLAN segmentation offload
# enabled on eth0. This corrupts Cilium's VXLAN-encapsulated overlay
# traffic on receipt — ICMP keeps working (not tunneled the same way),
# but real pod-to-pod TCP/UDP from this node silently breaks (DNS
# timeouts, Argo CD unable to reach its own repo-server, etc.), even
# though Cilium's own node-to-node health check can look fine. Confirmed
# by hand multiple times on 1A100.22V; disabling it before RKE2/Cilium
# ever start avoids the issue entirely. `|| true`: harmless no-op on
# instance types where these are already fixed off.
ethtool -K eth0 tx-udp_tnl-segmentation off tx-udp_tnl-csum-segmentation off tx-udp-segmentation off || true

# Longhorn (installed on the server via RKE2's helm-controller, but
# scheduled across every node) needs open-iscsi and a running iscsid
# here too, which RKE2 doesn't set up on its own.
# cloud-init runs its own apt-get on first boot and may still hold the
# package lock when this script starts — wait for it, then retry briefly
# in case something else (e.g. unattended-upgrades) grabs it instead.
cloud-init status --wait >/dev/null 2>&1 || true
for i in $(seq 1 12); do
  apt-get update -y && apt-get install -y open-iscsi nfs-common && break
  sleep 5
  [ "$i" -eq 12 ] && exit 1
done
systemctl enable --now iscsid

curl -sfL https://get.rke2.io | INSTALL_RKE2_TYPE="agent" INSTALL_RKE2_VERSION="${rke2_version}" sh -

mkdir -p /etc/rancher/rke2
cat > /etc/rancher/rke2/config.yaml <<CONFIG
server: "${server_url}"
token: "${token}"
CONFIG

systemctl enable rke2-agent.service
systemctl start rke2-agent.service
